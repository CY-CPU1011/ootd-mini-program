/* components/ootd-popup/ootd-popup.wxss */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.popup-mask.visible {
  opacity: 1;
  pointer-events: auto;
}

.popup-container {
  background-color: white;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx;
  position: relative;
  max-height: 90vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.popup-mask.visible .popup-container {
  transform: translateY(0);
}

.handle {
  width: 80rpx;
  height: 10rpx;
  background-color: #e0e0e0;
  border-radius: 6rpx;
  margin: 0 auto 40rpx;
}

.close-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.popup-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.outfit-suggestion {
  background-color: #f9f9f9;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.outfit-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon-lightbulb {
  margin-right: 16rpx;
  color: #07c160;
  font-size: 36rpx;
}

.outfit-title-text {
  font-size: 32rpx;
  font-weight: 600;
}

.outfit-content {
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

.carousel {
  position: relative;
  margin: 40rpx 0;
  border-radius: 32rpx;
  overflow: hidden;
  height: 800rpx;
}

.carousel-inner {
  display: flex;
  transition: transform 0.5s ease;
  height: 100%;
}

.carousel-item {
  min-width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
}

.carousel-control {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.carousel-prev {
  left: 20rpx;
}

.carousel-next {
  right: 20rpx;
}

.carousel-indicators {
  position: absolute;
  bottom: 30rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
}

.indicator.active {
  background-color: white;
}

.share-btn {
  background-color: #07c160;
  color: white;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-weight: bold;
  width: 100%;
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

/* 图标样式 */
.icon-close:before {
  content: "×";
  font-size: 40rpx;
}

.icon-lightbulb:before {
  content: "💡";
}

.icon-chevron-left:before {
  content: "❮";
  font-size: 36rpx;
}

.icon-chevron-right:before {
  content: "❯";
  font-size: 36rpx;
}

.icon-share:before {
  content: "🔗";
}

/* 无图片提示样式 */
.no-images {
  width: 100%;
  height: 300rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  margin-top: 24rpx;
}

.no-images-text {
  color: #999;
  font-size: 28rpx;
}