<!--components/ootd-popup/ootd-popup.wxml-->
<view class="popup-mask {{visible ? 'visible' : ''}}" bindtap="closePopup" catchtouchmove="preventTouchMove">
  <!-- 弹出层 -->
  <view class="popup-container" catchtap="preventBubble" catchtouchmove="preventTouchMove">
    <view class="handle"></view>
    <view class="close-btn" bindtap="closePopup">
      <text class="icon-close"></text>
    </view>

    <view class="popup-title">今日OOTD推荐</view>
    <view class="popup-subtitle">基于当前天气和你选择的「{{selectedStyle}}」风格</view>

    <!-- 加载状态展示骨架图 -->
    <block wx:if="{{isLoading}}">
      <ootd-skeleton></ootd-skeleton>
    </block>

    <!-- 已加载内容 -->
    <block wx:else>
      <!-- 穿搭建议 -->
      <view class="outfit-suggestion">
        <view class="outfit-title">
          <text class="icon-lightbulb"></text>
          <view class="outfit-title-text">穿搭建议</view>
        </view>
        <view class="outfit-content">
          {{outfitSuggestion}}
        </view>
      </view>

      <!-- 图片轮播 -->
      <view class="carousel" wx:if="{{outfitImages.length > 0}}">
        <view class="carousel-inner" style="transform: translateX(-{{currentSlide * 100}}%)">
          <view class="carousel-item" wx:for="{{outfitImages}}" wx:key="index" style="background-image: url('{{item}}')"></view>
        </view>

        <view class="carousel-control carousel-prev" bindtap="prevSlide" wx:if="{{outfitImages.length > 1}}">
          <text class="icon-chevron-left"></text>
        </view>
        <view class="carousel-control carousel-next" bindtap="nextSlide" wx:if="{{outfitImages.length > 1}}">
          <text class="icon-chevron-right"></text>
        </view>

        <view class="carousel-indicators" wx:if="{{outfitImages.length > 1}}">
          <view class="indicator {{currentSlide === index ? 'active' : ''}}"
                wx:for="{{outfitImages}}"
                wx:key="index"
                bindtap="goToSlide"
                data-index="{{index}}"></view>
        </view>
      </view>

      <!-- 无图片提示 -->
      <view class="no-images" wx:else>
        <view class="no-images-text">暂无穿搭图片，请稍后再试</view>
      </view>
    </block>
  </view>
</view>
