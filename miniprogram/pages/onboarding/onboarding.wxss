/**onboarding.wxss**/
page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: #f8f9fa;
  color: #333;
  min-height: 100vh;
}

.onboarding-container {
  max-width: 100%;
  padding: 40rpx;
}

.onboarding-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.onboarding-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #07c160, #10b981);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.2);
}

.icon-tshirt {
  font-size: 80rpx;
  color: white;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.form-card {
  background-color: white;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-weight: 500;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx 32rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 24rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  height: auto;
  min-height: 88rpx; /* 确保输入框高度足够 */
  color: #333; /* 确保文字颜色足够深 */
}

/* 设置placeholder样式 */
.form-input::placeholder {
  color: #999;
  font-size: 28rpx;
}

/* 特别为文本域设置更大的高度 */
textarea.form-input {
  min-height: 180rpx;
  height: 180rpx;
  line-height: 1.5;
}

.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  padding: 24rpx;
  border: 4rpx solid #e0e0e0;
  border-radius: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.gender-option.selected {
  border-color: #07c160;
  background-color: #f0f9f4;
}

.icon-male, .icon-female {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  color: #999;
  display: block;
}

.gender-option.selected .icon-male,
.gender-option.selected .icon-female {
  color: #07c160;
}

.tip-card {
  background-color: #e6f7ff;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 48rpx;
}

.tip-content {
  display: flex;
  align-items: flex-start;
}

.icon-info {
  color: #1890ff;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #0050b3;
  flex: 1;
}

.submit-btn {
  background-color: #07c160;
  color: white;
  border-radius: 24rpx;
  padding: 28rpx;
  font-weight: bold;
  width: 100%;
  margin-top: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  font-size: 32rpx;
}

.icon-check {
  margin-left: 8rpx;
}

/* 图标样式 - 使用伪元素模拟图标 */
.icon-tshirt:before {
  content: "👕";
}

.icon-male:before {
  content: "👨";
}

.icon-female:before {
  content: "👩";
}

.icon-info:before {
  content: "ℹ️";
}

.icon-check:before {
  content: "✓";
}